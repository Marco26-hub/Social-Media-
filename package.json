{
  "name": "social-automation-admin",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run remotion:browser && next build",
    "remotion:browser": "node scripts/ensure-remotion-browser.mjs",
    "test": "playwright test lib/*.test.ts --workers=1",
    "start": "node scripts/render-start.mjs",
    "lint": "eslint .",
    "migrate": "node scripts/run-migrations.mjs",
    "migrate:dry": "node scripts/run-migrations.mjs --dry-run",
    "prod:check": "node scripts/render-production-check.mjs",
    "prod:check:strict": "node scripts/render-production-check.mjs --strict",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "render:sync-env": "node scripts/render-sync-env.mjs",
    "ci:verify": "npm run lint && npm run build && npm audit --audit-level=moderate && npm run migrate:dry",
    "next:start": "next start",
    "demo:video": "node scripts/demo-walkthrough.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.516",
    "@remotion/renderer": "^4.0.516",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.23",
    "next-auth": "^4.24.15",
    "pg": "^8.13.1",
    "postcss": "8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.516",
    "swr": "^2.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "playwright": "^1.61.1"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  }
